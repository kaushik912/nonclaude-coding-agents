meta {
  name: GET unknown route (404)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/does-not-exist
  body: none
  auth: none
}

tests {
  test("status 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("error payload is JSON", function () {
    const type = res.getHeader("content-type") || "";
    expect(type).to.match(/application\/json/);
  });

  test("error body carries Spring details", function () {
    const body = res.getBody();
    expect(body).to.have.property("status", 404);
    expect(body).to.have.property("error", "Not Found");
    expect(body).to.have.property("path", "/does-not-exist");
    expect(body).to.have.property("timestamp");
  });
}

docs {
  Edge case: unknown path should yield Spring Boot's default 404 JSON error body.
}
