meta {
  name: Update Attendee Status
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/events/{{attendeeEventId}}/attendees/{{attendeeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ACCEPTED"
  }
}

tests {
  test("update attendee status returns 200", () => {
    expect(res.status).to.equal(200);
  });

  test("reflects accepted status", () => {
    expect(res.body.status).to.equal("ACCEPTED");
  });
}