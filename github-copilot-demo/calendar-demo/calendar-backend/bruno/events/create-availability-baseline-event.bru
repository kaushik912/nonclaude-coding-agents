meta {
  name: Create Availability Baseline Event
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/events
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Availability Baseline",
    "startTime": "2026-09-20T10:00:00Z",
    "endTime": "2026-09-20T11:00:00Z"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("availabilityEventId", res.body.id);
  }
}

tests {
  test("create baseline event returns 201", () => {
    expect(res.status).to.equal(201);
  });
}
